  "examples": [
    {
      "label": "Install deps + ODAT",
      "command": "sudo apt-get install -y build-essential python3-dev libaio1 python3-scapy\ngit clone https://github.com/quentinhardy/odat.git && cd odat/\ngit submodule init && git submodule update\nsudo pip3 install colorlog termcolor passlib python-libnmap pycryptodome\n./odat.py -h"
    },
    {
      "label": "Fix sqlplus libclntsh error",
      "command": "sudo sh -c \"echo /usr/lib/oracle/12.2/client64/lib > /etc/ld.so.conf.d/oracle-instantclient.conf\";sudo ldconfig"
    }
  ],
  "notes": "Config files: $ORACLE_HOME/network/admin/{tnsnames.ora,listener.ora}.",
