  ],
  "id": "linux-enum-users-groups",
  "name": "Enumeration - Users and Groups",
  "command": "cat /etc/passwd",
  "description": "Enumerate accounts, which ones have login shells (attack targets), group definitions, and membership of privileged groups like sudo/docker/lxd/disk/adm.",
  "variations": [
    {
      "label": "Users",
      "command": "cat /etc/passwd\ncat /etc/passwd | cut -f1 -d:\ngrep \"sh$\" /etc/passwd"
    },
    {
      "label": "Groups",
      "command": "cat /etc/group\ngetent group sudo\nls /home"
    }
  ],
